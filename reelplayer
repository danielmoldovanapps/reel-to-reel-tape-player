def preferences_file():
    return os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')),
                        'reelplayer', 'prefs.json')

def sanitize_preferences(data):
    # A malformed or outdated preference file must never prevent launch.
    if not isinstance(data, dict):
        raise ValueError('Invalid preferences')
    vol = data.get('vol', 1)
    if type(vol) not in (float, int) or not 0 <= vol <= 1:
        raise ValueError('Invalid volume')
    repeat = data.get('repeat', 0)
    if type(repeat) is not int or not 0 <= repeat <= 2:
        raise ValueError('Invalid repeat setting')
    shuffle = data.get('shuffle', False)
    if type(shuffle) is not bool:
        raise ValueError('Invalid shuffle setting')
    return {'vol': float(vol), 'repeat': repeat, 'shuffle': shuffle}

def read_preferences():
    try:
        with open(preferences_file(), encoding='utf-8') as f:
            return sanitize_preferences(json.load(f))
    except (OSError, ValueError, TypeError, AttributeError):
        return {'vol': 1.0, 'repeat': 0, 'shuffle': False}

def write_preferences(data):
    values = sanitize_preferences(data)
    dest = preferences_file()
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(values, f)
    os.replace(tmp, dest)

def branding_file():
    return os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')), 'reelplayer', 'branding.json')

def read_branding():
    try:
        with open(branding_file(), encoding='utf-8') as f: data=json.load(f)
        return {'reels': str(data.get('reels',''))[:24], 'deck': str(data.get('deck',''))[:30]}
    except (OSError, ValueError, TypeError, AttributeError):
        return {'reels':'', 'deck':''}

def write_branding(data):
    values={'reels':str(data.get('reels',''))[:24], 'deck':str(data.get('deck',''))[:30]}
    path=branding_file(); os.makedirs(os.path.dirname(path),exist_ok=True)
    tmp=path+'.tmp'
    with open(tmp,'w',encoding='utf-8') as f: json.dump(values,f,ensure_ascii=False)
    os.replace(tmp,path)

def playlist_file():
    return os.path.join(os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config')),
                        'reelplayer', 'playlist.json')

def read_playlist():
    try:
        with open(playlist_file(), encoding='utf-8') as f: data=json.load(f)
        if isinstance(data, list):
            return [p for p in data[:20000] if isinstance(p,str) and os.path.isabs(p)]
    except (OSError, ValueError, TypeError): pass
    return []

def write_playlist(paths):
    if not isinstance(paths,list) or len(paths)>20000: raise ValueError('Invalid playlist')
    values=[]
    for path in paths:
        if not isinstance(path,str) or not os.path.isabs(path) or len(path)>4096:
            raise ValueError('Invalid path')
        values.append(path)
    dest=playlist_file(); os.makedirs(os.path.dirname(dest),exist_ok=True)
    tmp=dest+'.tmp'
    with open(tmp,'w',encoding='utf-8') as f: json.dump(values,f,ensure_ascii=False)
    os.replace(tmp,dest)

def track_json():
    return [{'id':i,'name':os.path.basename(path), 'rel':os.path.basename(path),'size':os.path.getsize(path)}
            for i,(_,path) in enumerate(FILES)]

def legal_notice_file():
    config = os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config'))
    return os.path.join(config, 'reelplayer', 'license-notice.json')

def legal_notice_seen():
    try:
        with open(legal_notice_file()) as f: return json.load(f).get('notice') == LEGAL_NOTICE_ID
    except (OSError, ValueError): return False

def mark_legal_notice_seen():
    path = legal_notice_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f: json.dump({'notice': LEGAL_NOTICE_ID}, f)

def show_launch_error(message):
    print(message, file=sys.stderr)
    try:
        if shutil.which('zenity'):
            subprocess.run(['zenity', '--error', '--title=ReelPlayer', '--text='+message], check=False)
        elif shutil.which('kdialog'):
            subprocess.run(['kdialog', '--error', message, '--title', 'ReelPlayer'], check=False)
        else:
            import tkinter as tk
            from tkinter import messagebox
            root = tk.Tk(); root.withdraw()
            messagebox.showerror('ReelPlayer', message, parent=root)
            root.destroy()
    except Exception:
        pass

def add_external_paths(paths):
    """Append files or a folder to the current library, keeping existing IDs stable.

    Return a browser event that plays the first selected file, even if already
    present. A duplicate open never creates another library entry or window.
    """
    found = []
    with FILE_LOCK:
        existing = {path: index for index, (_, path) in enumerate(FILES)}
        for item in paths:
            path = os.path.realpath(os.path.expanduser(item))
            if os.path.isfile(path):
                if os.path.splitext(path)[1].lower() in EXTS:
                    found.append((os.path.dirname(path), path))
            elif os.path.isdir(path):
                for folder, _, names in os.walk(path):
                    for name in names:
                        f = os.path.join(folder, name)
                        if os.path.splitext(f)[1].lower() in EXTS:
                            found.append((path, f))
        found.sort(key=lambda item: [int(x) if x.isdigit() else x.lower()
                                    for x in re.split(r'(\d+)', item[1])])
        additions = []
        selected = []
        for root, path in found:
            if path not in existing:
                index = len(FILES)
                FILES.append((root, path))
                existing[path] = index
                additions.append({'id': index, 'name': os.path.basename(path),
                                  'rel': os.path.relpath(path, root).replace(os.sep, '/'), 'size': os.path.getsize(path)})
            selected.append(existing[path])
            if root not in ROOTS: ROOTS.append(root)
        if selected:
            event = {'tracks': additions, 'play': selected[0]}
            PENDING_OPEN_EVENTS.append(event)
            return event
    return None


def initial_library():
    """Restore playlist or use ~/Music without starting playback on icon launch."""
    with FILE_LOCK:
        if os.path.isfile(playlist_file()):
            for path in read_playlist():
                if os.path.isfile(path) and os.path.splitext(path)[1].lower() in EXTS:
                    FILES.append((os.path.dirname(path), path))
        else:
            music = os.path.expanduser('~/Music')
            if os.path.isdir(music):
                ROOTS.append(music)
                scan([music])


def main():
    args = sys.argv[1:]
    if '--license' in args:
        print(open(os.path.join(HERE, 'COPYRIGHT')).read())
        print(open(os.path.join(HERE, 'LICENSE')).read())
        return 0
    if '--install' in args:
        install()
        return 0
    try:
        import gi
        gi.require_version('Gtk', '3.0')
        gi.require_version('WebKit2', '4.1')
        from gi.repository import Gtk, Gio, GLib, Gdk, WebKit2
    except (ImportError, ValueError) as error:
        show_launch_error('WebKitGTK dependencies are missing. Install python3-gi, '
                          'gir1.2-gtk-3.0 and gir1.2-webkit2-4.1.\n' + str(error))
        return 1

    class ReelApplication(Gtk.Application):
        def __init__(self):
            super().__init__(application_id='org.reelplayer.ReelPlayer',
                             flags=Gio.ApplicationFlags.HANDLES_OPEN)
            self.window = None
            self.server = None

        def do_startup(self):
            Gtk.Application.do_startup(self)
            global NATIVE_PLAY_DISPATCH
            NATIVE_PLAY_DISPATCH = self._dispatch_native_play
            initial_library()
            self.server = ThreadingHTTPServer(('127.0.0.1', 0), H)
            self.server.daemon_threads = True
            threading.Thread(target=self.server.serve_forever, daemon=True).start()
            self.url = 'http://127.0.0.1:%s/?k=%s' % (self.server.server_port, TOKEN)

        def _dispatch_native_play(self, track_id):
            if getattr(self, 'webview', None) is None:
                return False
            def start_on_gtk_thread():
                try:
                    # WebKit2GTK's run_javascript executes host-triggered JS
                    # with user activation, unlike a fetch/timer callback.
                    # This lets the ORIGINAL Web Audio transport start on
                    # the same engine used by the Play button.
                    self.webview.run_javascript(
                        'window.reelPlayerStartExternal(%d);' % track_id,
                        None, None)
                except Exception as error:
                    print('Native WebKit playback activation failed:',
                          error, file=sys.stderr)
                return False
            GLib.idle_add(start_on_gtk_thread)
            return True

        def do_activate(self):
            if self.window is not None:
                self.window.present()
                return
            self.window = Gtk.ApplicationWindow(application=self)
            self.window.set_title('Reel-to-Reel Tape Player')
            self.window.set_default_size(1180, 780)
            self.window.set_size_request(700, 460)
            try:
                self.window.set_icon_from_file(os.path.join(HERE, 'icon.svg'))
            except GLib.Error:
                pass
            config = os.environ.get('XDG_CONFIG_HOME', os.path.expanduser('~/.config'))
            cache = os.environ.get('XDG_CACHE_HOME', os.path.expanduser('~/.cache'))
            data_dir = os.path.join(config, 'reelplayer', 'webkit-data')
            cache_dir = os.path.join(cache, 'reelplayer', 'webkit-cache')
            os.makedirs(data_dir, exist_ok=True)
            os.makedirs(cache_dir, exist_ok=True)
            manager = WebKit2.WebsiteDataManager(base_data_directory=data_dir,
                                                  base_cache_directory=cache_dir)
            context = WebKit2.WebContext.new_with_website_data_manager(manager)
            self.webview = WebKit2.WebView.new_with_context(context)
            settings = self.webview.get_settings()
            settings.set_enable_javascript(True)
            settings.set_enable_webaudio(True)
            settings.set_enable_mediasource(True)
            settings.set_media_playback_requires_user_gesture(False)
            # File-manager opens must autoplay without requiring a click in WebKit.
            if hasattr(self.webview, 'set_autoplay_policy'):
                self.webview.set_autoplay_policy(WebKit2.AutoplayPolicy.ALLOW)
            self.window.add(self.webview)
            self.window.show_all()
            # Open the deck maximized on each launch (not exclusive fullscreen).
            # The window manager can still restore/unmaximize it normally.
            self.window.maximize()
            self.webview.load_uri(self.url)

        def do_open(self, files, n_files, hint):
            # Gio automatically forwards Open-With launches to this one instance.
            paths = [f.get_path() for f in files if f.get_path()]
            if paths:
                add_external_paths(paths)
            self.activate()  # presents the already-open deck; does not spawn another

        def do_shutdown(self):
            if self.server:
                self.server.shutdown()
                self.server.server_close()
            Gtk.Application.do_shutdown(self)

    application = ReelApplication()
    # Pass original arguments so GApplication handles file opens and D-Bus
    # forwarding; Gtk.Application is unique unless NON_UNIQUE is requested.
    return application.run([sys.argv[0]] + args)


if __name__ == '__main__':
    try:
        sys.exit(main() or 0)
    except Exception as error:
        show_launch_error('Reel-to-Reel Tape Player could not start: ' + str(error))
        sys.exit(1)
