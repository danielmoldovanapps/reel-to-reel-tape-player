"""Reel-to-Reel Tape Player — GTK3/WebKit2GTK native shell.

One GTK application instance per desktop session. Files opened by the file manager
are delivered to that instance and played automatically. Browser not required.
"""
import os, sys, json, secrets, shutil, subprocess, threading, time, mimetypes, urllib.parse, re, io, wave
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler

HERE = os.path.dirname(os.path.realpath(__file__))
from artwork import get_artwork
from streaminfo import get_track_info

ICON_SVG = open(os.path.join(HERE, 'icon.svg')).read() if os.path.exists(os.path.join(HERE, 'icon.svg')) else ''
EXTS = {'.mp3','.flac','.ogg','.oga','.opus','.wav','.m4a','.aac','.weba'}
TOKEN = secrets.token_urlsafe(16)
FILES, ROOTS = [], []
state = {'ping': 0.0, 'bye': 0.0, 'start': time.time()}
FILE_LOCK = threading.RLock()
PENDING_OPEN_EVENTS = []
# One-time authorization for starting a file-manager-selected track in a
# native WebKitGTK JavaScript invocation (with a user activation context).
NATIVE_PLAY_READY = set()
NATIVE_PLAY_DISPATCH = None

# A fixed allowlisted external destination; never accept an arbitrary URL from
# HTTP requests. The authentication token is randomized per player launch.
PAYPAL_DONATION_URL = 'https://www.paypal.me/danielmoldovanapps'

def open_donation_browser():
    """Open the selected donation site in the OS default browser, not WebKit."""
    # GIO uses the host URI handler (via desktop portals for Flatpak apps).
    try:
        import gi
        from gi.repository import Gio
        if Gio.AppInfo.launch_default_for_uri(PAYPAL_DONATION_URL, None):
            return True
    except Exception:
        pass
    opener = shutil.which('xdg-open')
    if opener:
        try:
            subprocess.Popen([opener, PAYPAL_DONATION_URL],
                             stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL,start_new_session=True)
            return True
        except OSError:
            pass
    return False

def scan(paths):
    for p in paths:
        p = os.path.abspath(os.path.expanduser(p))
        if os.path.isfile(p) and os.path.splitext(p)[1].lower() in EXTS:
            FILES.append((os.path.dirname(p), p)); continue
        for d, _, fs in os.walk(p):
            for f in fs:
                if os.path.splitext(f)[1].lower() in EXTS: FILES.append((p, os.path.join(d, f)))
    import re
    nat = lambda t: [int(x) if x.isdigit() else x.lower() for x in re.split(r'(\d+)', t[1])]
    FILES.sort(key=nat)

def pick_folder():
    """Open a native desktop folder dialog; no browser file-upload flow."""
    zenity = shutil.which('zenity')
    if zenity:
        p = subprocess.run([zenity, '--file-selection', '--directory', '--title=Choose music folder'],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        return p.stdout.strip() if p.returncode == 0 else ''
    kdialog = shutil.which('kdialog')
    if kdialog:
        p = subprocess.run([kdialog, '--getexistingdirectory', os.path.expanduser('~/Music'), '--title', 'Choose music folder'],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        return p.stdout.strip() if p.returncode == 0 else ''
    # Tk is commonly available on desktop Python installs; keep it as a fallback.
    try:
        import tkinter as tk
        from tkinter import filedialog
        root = tk.Tk(); root.withdraw(); root.attributes('-topmost', True)
        path = filedialog.askdirectory(title='Choose music folder', initialdir=os.path.expanduser('~/Music'))
        root.destroy()
        return path or ''
    except Exception:
        return ''

def scan_added(root):
    root = os.path.abspath(os.path.expanduser(root))
    found = []
    for d, _, names in os.walk(root):
        for name in names:
            if os.path.splitext(name)[1].lower() in EXTS:
                found.append((root, os.path.join(d, name)))
    def nat(item):
        return [int(x) if x.isdigit() else x.lower() for x in re.split(r'(\d+)', item[1])]
    found.sort(key=nat)
    start = len(FILES)
    FILES.extend(found)
    if root not in ROOTS: ROOTS.append(root)
    return [{'id': i, 'name': os.path.basename(path), 'rel': os.path.relpath(path, root).replace(os.sep, '/'), 'size': os.path.getsize(path)}
            for i, (_, path) in enumerate(FILES[start:], start)]

class H(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'
    def log_message(self, *a): pass
    def _send(self, code, body=b'', ctype='text/plain', extra=None):
        self.send_response(code); self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(body)))
        for k, v in (extra or {}).items(): self.send_header(k, v)
        self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        u = urllib.parse.urlparse(self.path); q = urllib.parse.parse_qs(u.query)
        if u.path == '/manifest.webmanifest':
            manifest = {'name':'Reel-to-Reel Tape Player','short_name':'Reel-to-Reel','display':'standalone','start_url':'/',
                        'icons':[{'src':'/icon.svg','sizes':'any','type':'image/svg+xml','purpose':'any'}]}
            return self._send(200, json.dumps(manifest).encode(), 'application/manifest+json')
        if u.path == '/icon.svg':
            return self._send(200, ICON_SVG.encode(), 'image/svg+xml')
        if u.path == '/metadata-reader.js':
            return self._send(200, open(os.path.join(HERE, 'metadata-reader.js'), 'rb').read(), 'application/javascript; charset=utf-8')
        if u.path == '/tape-engine.js':
            return self._send(200, open(os.path.join(HERE, 'tape-engine.js'), 'rb').read(), 'application/javascript; charset=utf-8')
        if q.get('k', [''])[0] != TOKEN: return self._send(403, b'forbidden')
        if u.path in ('/', '/index.html'):
            return self._send(200, open(os.path.join(HERE, 'index.html'), 'rb').read(), 'text/html; charset=utf-8')
        if u.path.startswith('/info/'):
            try:
                idx = int(u.path[6:])
                if idx < 0: raise IndexError
                path = FILES[idx][1]
            except (ValueError, IndexError): return self._send(404)
            return self._send(200, json.dumps(get_track_info(path)).encode(), 'application/json')
        if u.path == '/api/prefs':
            return self._send(200, json.dumps(read_preferences()).encode(), 'application/json',
                              {'Cache-Control':'no-store'})
        if u.path == '/api/branding':
            return self._send(200, json.dumps(read_branding()).encode(), 'application/json')
        if u.path == '/api/license-status':
            return self._send(200, json.dumps({'seen': legal_notice_seen()}).encode(), 'application/json')
        if u.path == '/api/ping': state['ping'] = time.time(); return self._send(204)
        if u.path == '/api/bye': state['bye'] = time.time(); return self._send(204)
        if u.path == '/api/open-events':
            with FILE_LOCK:
                events = PENDING_OPEN_EVENTS[:]
                PENDING_OPEN_EVENTS.clear()
                # Only a real desktop Open-With event may request activation.
                for event in events:
                    if isinstance(event.get('play'), int):
                        NATIVE_PLAY_READY.add(event['play'])
            return self._send(200, json.dumps(events).encode(), 'application/json',
                              {'Cache-Control': 'no-store'})
        if u.path == '/api/library':
            with FILE_LOCK:
                tr = [{'id': i, 'name': os.path.basename(p), 'rel': os.path.relpath(p, root).replace(os.sep, '/'), 'size': os.path.getsize(p)} for i, (root, p) in enumerate(FILES)]
            return self._send(200, json.dumps({'root': ', '.join(os.path.basename(r) or r for r in ROOTS), 'tracks': tr}).encode(), 'application/json')
        if u.path == '/api/pick-folder':
            folder = pick_folder()
            if not folder:
                return self._send(200, json.dumps({'tracks': []}).encode(), 'application/json')
            added = scan_added(folder)
            return self._send(200, json.dumps({'root': ', '.join(os.path.basename(r) or r for r in ROOTS), 'tracks': added}).encode(), 'application/json')
        if u.path.startswith('/art/'):
            try:
                idx = int(u.path[5:])
                if idx < 0: raise IndexError
                path = FILES[idx][1]
            except (ValueError, IndexError): return self._send(404)
            art = get_artwork(path)
            if not art: return self._send(404)
            return self._send(200, art[0], art[1], {'Cache-Control': 'private, max-age=3600'})
        if u.path.startswith('/preview/'):
            # Fast-start PCM preview. Decode only the opening minute rather than
            # waiting for a whole hour-long mix. The normal audio engine still
            # decodes the full track in parallel for full seeking and rewind.
            try:
                idx=int(u.path[len('/preview/'):])
                if idx<0: raise IndexError
                path=FILES[idx][1]
            except (ValueError, IndexError): return self._send(404)
            if not shutil.which('ffmpeg'):
                return self._send(503, b'ffmpeg is required for fast-start previews')
            try:
                # WAV headers need a real data length, so capture a bounded
                # 60-second PCM fragment before sending it to Web Audio.
                cmd=['ffmpeg','-nostdin','-hide_banner','-loglevel','error',
                     '-i',path,'-t','60','-map','0:a:0','-vn',
                     '-ac','2','-ar','44100','-f','s16le','pipe:1']
                pcm=subprocess.run(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,
                                   timeout=20,check=True).stdout
                if not pcm: raise ValueError('No audio data')
                wav_io=io.BytesIO()
                with wave.open(wav_io,'wb') as w:
                    w.setnchannels(2);w.setsampwidth(2);w.setframerate(44100)
                    w.writeframes(pcm)
                # ffprobe reads container metadata only, not the whole song.
                duration=0.0
                if shutil.which('ffprobe'):
                    result=subprocess.run(['ffprobe','-v','error',
                        '-show_entries','format=duration','-of','default=nw=1:nk=1',path],
                        stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,
                        text=True,timeout=5)
                    try: duration=float(result.stdout.strip())
                    except ValueError: pass
                return self._send(200,wav_io.getvalue(),'audio/wav',
                                  {'X-Reel-Duration':str(duration),'Cache-Control':'no-store'})
            except (subprocess.SubprocessError, OSError, ValueError) as e:
                return self._send(503, str(e).encode('utf-8','replace')[:250])
        if u.path.startswith('/file/'):
            try: path = FILES[int(u.path[6:])][1]
            except Exception: return self._send(404)
            size = os.path.getsize(path); start, end = 0, size - 1; code = 200
            r = self.headers.get('Range')
            if r and r.startswith('bytes='):
                a, _, b = r[6:].partition('-')
                start = int(a) if a else max(0, size - int(b)); end = min(int(b), size - 1) if a and b else size - 1; code = 206
            ctype = mimetypes.guess_type(path)[0] or 'application/octet-stream'
            self.send_response(code); self.send_header('Content-Type', ctype); self.send_header('Accept-Ranges', 'bytes')
            self.send_header('Content-Length', str(end - start + 1))
            if code == 206: self.send_header('Content-Range', f'bytes {start}-{end}/{size}')
            self.end_headers()
            try:
                with open(path, 'rb') as f:
                    f.seek(start); left = end - start + 1
                    while left > 0:
                        chunk = f.read(min(65536, left))
                        if not chunk: break
                        self.wfile.write(chunk); left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError): pass
            return
        self._send(404)
    def do_POST(self):
        u = urllib.parse.urlparse(self.path); q = urllib.parse.parse_qs(u.query)
        if q.get('k', [''])[0] != TOKEN: return self._send(403, b'forbidden')
        if u.path == '/api/native-play':
            # This request is sent only AFTER the page has loaded a desktop
            # Open-With event into its library. Execute playback from GTK's
            # native JavaScript API so WebKit can activate Web Audio, without
            # switching to a different (pitch-changing) playback engine.
            if self.headers.get('Origin', '').strip() not in ('',
                    'http://127.0.0.1:%s' % self.server.server_port):
                return self._send(403, b'Invalid origin')
            try:
                track_id=int(q.get('id', [''])[0])
            except ValueError:
                return self._send(400, b'Invalid track')
            with FILE_LOCK:
                if track_id not in NATIVE_PLAY_READY:
                    return self._send(409, b'No pending file-manager open')
                NATIVE_PLAY_READY.remove(track_id)
            if NATIVE_PLAY_DISPATCH is None or not NATIVE_PLAY_DISPATCH(track_id):
                return self._send(503, b'Native WebKit bridge unavailable')
            return self._send(204)
        if u.path == '/api/open-donation':
            # POST + per-process secret prevents a random website from opening
            # donation pages through this localhost-only server.
            if self.headers.get('Origin', '').strip() not in ('',
                    'http://127.0.0.1:%s' % self.server.server_port):
                return self._send(403,b'Invalid origin')
            if not open_donation_browser():
                return self._send(503,b'No external browser available')
            return self._send(204)
        if u.path == '/api/playlist':
            try:
                length=int(self.headers.get('Content-Length','0'))
                if length<0 or length>1048576: return self._send(413)
                data=json.loads(self.rfile.read(length))
                if not isinstance(data,list): return self._send(400)
                # Only accept paths of files already opened by this local application.
                known={path for _,path in FILES}
                chosen=[]
                for i in data:
                    if not isinstance(i,int) or i<0 or i>=len(FILES): return self._send(400)
                    chosen.append(FILES[i][1])
                write_playlist(chosen)
            except (OSError,ValueError,TypeError): return self._send(400,b'Playlist save failed')
            return self._send(204)
        if u.path == '/api/prefs':
            try:
                length=int(self.headers.get('Content-Length','0'))
                if length<=0 or length>4096: return self._send(413)
                incoming=json.loads(self.rfile.read(length))
                write_preferences(incoming)
            except (OSError, ValueError, TypeError, AttributeError):
                return self._send(400,b'Could not save preferences')
            return self._send(204)
        if u.path == '/api/branding':
            try:
                length=int(self.headers.get('Content-Length','0'))
                if length < 0 or length > 4096: return self._send(413)
                data=json.loads(self.rfile.read(length))
                if not isinstance(data,dict): return self._send(400)
                write_branding(data)
            except (OSError, ValueError, TypeError):
                return self._send(400,b'Could not save branding')
            return self._send(204)
        if u.path != '/api/license-seen': return self._send(404)
        try: mark_legal_notice_seen()
        except OSError: return self._send(500, b'Could not save license notice preference')
        return self._send(204)

    do_HEAD = do_GET

